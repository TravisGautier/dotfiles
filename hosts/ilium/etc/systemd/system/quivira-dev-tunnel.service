[Unit]
Description=Forward ilium localhost:3000 to quivira:3000 (partymasters dev server, via VPS jump)
After=network-online.target
Wants=network-online.target

[Service]
User=travis
ExecStart=/usr/bin/ssh -N \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -o IdentitiesOnly=yes \
  -i /home/travis/.ssh/id_surface_client \
  -o UserKnownHostsFile=/home/travis/.ssh/known_hosts \
  -o ProxyCommand='/usr/bin/ssh -i /home/travis/.ssh/id_surface_client -o UserKnownHostsFile=/home/travis/.ssh/known_hosts -o IdentitiesOnly=yes -o BatchMode=yes -W %h:%p deploy@5.78.90.153' \
  -L 127.0.0.1:3000:127.0.0.1:3000 \
  -p 7777 travis@127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
